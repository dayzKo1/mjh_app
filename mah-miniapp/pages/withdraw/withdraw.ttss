.container {
  background: linear-gradient(180deg, #6b8e6b 0%, #8dac85 30%, #6b8e6b 100%);
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.balance-card {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.balance-amount {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.type-notice {
  background: rgba(255, 200, 100, 0.2);
  border: 2rpx solid rgba(255, 200, 100, 0.4);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.type-notice-text {
  font-size: 26rpx;
  color: #ffd666;
}

.form-section {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.form-label {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.amount-input {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.quick-amounts {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  transition: all 0.15s ease;
}

.quick-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.35);
}

.all-btn {
  text-align: center;
  padding: 16rpx 0;
  color: #fff;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.submit-btn {
  background: linear-gradient(180deg, #5cb85c 0%, #449d44 100%);
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  transition: all 0.15s ease;
}

.submit-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.submit-btn.disabled {
  background: linear-gradient(180deg, #999 0%, #777 100%);
  pointer-events: none;
  box-shadow: none;
}

.rules {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.rules-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: bold;
  margin-bottom: 12rpx;
}

.rules-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.8;
}

.records-section {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
}

.records-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.records-empty {
  text-align: center;
  padding: 40rpx 0;
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-amount {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
}

.record-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 6rpx;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.status-pending {
  color: #ffd666;
  background: rgba(255, 214, 102, 0.15);
  border: 1rpx solid rgba(255, 214, 102, 0.3);
}

.status-approved {
  color: #73d13d;
  background: rgba(115, 209, 61, 0.15);
  border: 1rpx solid rgba(115, 209, 61, 0.3);
}

.status-rejected {
  color: #ff7875;
  background: rgba(255, 120, 117, 0.15);
  border: 1rpx solid rgba(255, 120, 117, 0.3);
}
