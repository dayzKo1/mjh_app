.container {
  background: linear-gradient(180deg, #6b8e6b 0%, #8dac85 30%, #6b8e6b 100%);
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

.invite-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 8rpx;
  letter-spacing: 4rpx;
}

.card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
}

.invite-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 28rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.share-btn {
  width: 100%;
  padding: 20rpx 0;
  background: linear-gradient(180deg, #5cb85c 0%, #449d44 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  border: none;
  text-align: center;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.invite-code {
  width: 100%;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.code-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 16rpx;
  white-space: nowrap;
}

.code-value {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-btn {
  padding: 10rpx 28rpx;
  background: linear-gradient(180deg, #5cb85c 0%, #449d44 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  white-space: nowrap;
}

.copy-btn:active {
  transform: scale(0.95);
}

.rules-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.rules-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.rules-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.rules-icon-img {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.rules-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.rules-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.bind-entry {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.bind-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.bind-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: bold;
}

.invite-list {
  width: 100%;
}

.level-section {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.level-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.level-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.level-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: bold;
  transition: transform 0.2s ease;
  transform: rotate(0deg);
}

.level-arrow.expanded {
  transform: rotate(90deg);
}

.level-body {
  padding: 0 28rpx 16rpx;
}

.friend-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.friend-item:last-child {
  border-bottom: none;
}

.friend-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.friend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.friend-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}

.friend-commission {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.empty-tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(180deg, #5cb85c 0%, #449d44 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.modal-btn:active {
  transform: scale(0.97);
}
