.container {
  background: linear-gradient(180deg, #6b8e6b 0%, #8dac85 30%, #6b8e6b 100%);
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

/* Tab栏 */
.tabs {
  display: flex;
  width: 100%;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  font-weight: bold;
  position: relative;
  transition: all 0.2s ease;
}

.tab-active {
  color: #fff;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #5cb85c;
  border-radius: 3rpx;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
}

/* 空列表 */
.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
}

/* 排行列表 */
.rank-list {
  width: 100%;
  padding-bottom: 140rpx;
}

/* 排行每行 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

/* 前三名特殊样式 */
.rank-top {
  background: rgba(255,255,255,0.18);
  border: 1.5rpx solid rgba(255,255,255,0.15);
}

.rank-top-1 {
  background: linear-gradient(135deg, rgba(255,215,0,0.25) 0%, rgba(255,193,7,0.15) 100%);
  border-color: rgba(255,215,0,0.35);
}

.rank-top-2 {
  background: linear-gradient(135deg, rgba(192,192,192,0.25) 0%, rgba(169,169,169,0.15) 100%);
  border-color: rgba(192,192,192,0.35);
}

.rank-top-3 {
  background: linear-gradient(135deg, rgba(205,127,50,0.25) 0%, rgba(184,115,51,0.15) 100%);
  border-color: rgba(205,127,50,0.35);
}

/* 排名数字 */
.rank-number {
  width: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.rank-medal {
  width: 40rpx;
  height: 40rpx;
}

/* 圆形头像 */
.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin: 0 20rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
  flex-shrink: 0;
  background: rgba(255,255,255,0.1);
}

/* 昵称 */
.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分数/佣金值 */
.rank-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffeb3b;
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 自己的排名 - 底部固定 */
.my-rank {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 8rpx));
  background: linear-gradient(180deg, #5cb85c 0%, #449d44 100%);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.2);
  z-index: 10;
}

.my-rank .rank-number {
  color: #fff;
}

.my-rank .rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-color: rgba(255,255,255,0.5);
}

.my-rank .rank-name {
  color: #fff;
  font-weight: bold;
}

.my-rank .rank-value {
  color: #ffeb3b;
}
