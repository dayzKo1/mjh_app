/* 游戏页面 - 包了个包主题 */

/* ===== 容器 ===== */
.container {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #fef3c7 0%, #fde68a 30%, #fcd34d 60%, #f59e0b 100%);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* ===== 四角布局 ===== */
.corner {
  position: absolute;
  z-index: 50;
}

/* 左上角：积分 */
.corner-left-top {
  left: 16rpx;
  top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-box {
  display: flex;
  flex-direction: column;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.2);
}

.score-label {
  font-size: 14rpx;
  color: #a16207;
}

.score-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400e;
}

.level-box {
  padding: 8rpx 12rpx;
  background: linear-gradient(145deg, #fff8dc, #ffe4b5);
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.2);
}

.level-text {
  font-size: 16rpx;
  color: #b45309;
  font-weight: 600;
}

/* 右上角：进度条 */
.corner-right-top {
  right: 16rpx;
  top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.progress-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  min-width: 120rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.2);
}

.progress-bar-bg {
  width: 100rpx;
  height: 12rpx;
  background: rgba(251, 191, 36, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease, background 0.3s ease;
}

.progress-text {
  font-size: 14rpx;
  color: #92400e;
  font-weight: 600;
}

/* 中央游戏区域 */
.game-area {
  position: absolute;
  left: 100rpx;
  right: 100rpx;
  top: 80rpx;
  bottom: 120rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  overflow: visible;
  box-shadow: 
    0 8rpx 32rpx rgba(245, 158, 11, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

/* 麻将牌卡片 */
.card {
  position: absolute;
  width: 72rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: linear-gradient(170deg, #fffef9, #faf5e8, #efe0c6);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 
    0 3rpx 12rpx rgba(0, 0, 0, 0.15),
    0 6rpx 20rpx rgba(245, 158, 11, 0.1),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.card-img {
  width: 56rpx;
  height: 72rpx;
}

.card.covered {
  opacity: 0.5;
  filter: grayscale(0.2) brightness(0.8);
}

.card.picked {
  opacity: 0;
  transform: scale(0.5);
  pointer-events: none;
}

.card.removed {
  opacity: 0;
  pointer-events: none;
}

.card.hint-highlight {
  box-shadow: 
    0 0 24rpx 12rpx rgba(34, 197, 94, 0.6),
    0 3rpx 12rpx rgba(0, 0, 0, 0.15);
  animation: hintPulse 0.5s ease-in-out 3;
}

@keyframes hintPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 左下角：暂存槽 */
.corner-left-bottom {
  left: 16rpx;
  bottom: 16rpx;
}

.slots-container {
  display: flex;
  flex-direction: row;
  gap: 6rpx;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.2);
}

.slot {
  width: 64rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: rgba(251, 191, 36, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
}

.slot.filled {
  background: linear-gradient(170deg, #fffef9, #faf5e8, #efe0c6);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.slot-img {
  width: 48rpx;
  height: 64rpx;
}

/* 右下角：道具按钮 */
.corner-right-bottom {
  right: 16rpx;
  bottom: 16rpx;
}

.props-container {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.2);
}

.prop-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
}

.prop-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(180deg, #fff8dc, #ffe4b5);
  border-radius: 14rpx;
  box-shadow: 
    0 4rpx 12rpx rgba(245, 158, 11, 0.25),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

.prop-btn-text {
  font-size: 16rpx;
  color: #92400e;
  font-weight: 600;
}

.prop-btn-count {
  font-size: 14rpx;
  color: #b45309;
  font-weight: 700;
  background: rgba(245, 158, 11, 0.2);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.prop-ad-btn {
  padding: 4rpx 8rpx;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  border-radius: 8rpx;
}

.prop-ad-text {
  font-size: 12rpx;
  color: #fff;
}

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(251, 191, 36, 0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 320rpx;
  background: linear-gradient(170deg, #fffef9, #faf5e8, #fef3c7);
  border-radius: 28rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 
    0 16rpx 48rpx rgba(245, 158, 11, 0.3),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.modal-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #92400e;
  margin-bottom: 16rpx;
}

.win-modal .modal-title {
  color: #16a34a;
}

.fail-modal .modal-title {
  color: #dc2626;
}

.warning-modal .modal-title {
  color: #d97706;
}

.modal-desc {
  font-size: 16rpx;
  color: #a16207;
  margin-bottom: 16rpx;
}

.modal-stats {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stat-label {
  font-size: 14rpx;
  color: #a16207;
}

.stat-value {
  font-size: 22rpx;
  color: #92400e;
  font-weight: 600;
}

.modal-btns {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.modal-btn {
  height: 44rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 14rpx;
  font-size: 18rpx;
  color: #92400e;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.15);
}

.modal-btn.primary {
  background: linear-gradient(180deg, #fff8dc, #ffe4b5);
  color: #92400e;
  font-weight: 600;
}

.ad-btn {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #fff;
}

.btn-ad-text {
  font-size: 16rpx;
}

/* ===== 道具选择面板 ===== */
.prop-panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(251, 191, 36, 0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1001;
}

.prop-panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.prop-panel-content {
  width: 400rpx;
  background: linear-gradient(170deg, #fffef9, #faf5e8, #fef3c7);
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 
    0 16rpx 48rpx rgba(245, 158, 11, 0.3),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.prop-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.prop-panel-title {
  font-size: 18rpx;
  color: #92400e;
  font-weight: 600;
}

.prop-panel-close {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(245, 158, 11, 0.2);
  border-radius: 50%;
  font-size: 16rpx;
  color: #92400e;
}

.prop-panel-body {
  max-height: 240rpx;
  overflow-y: auto;
}

.prop-items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: center;
}

.prop-items-grid {
  max-height: 220rpx;
}

.prop-item-card {
  width: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.15);
}

.prop-item-card.highlight {
  background: rgba(34, 197, 94, 0.2);
}

.prop-item-img {
  width: 48rpx;
  height: 64rpx;
}

.prop-item-label {
  font-size: 12rpx;
  color: #92400e;
}

.prop-item-count {
  font-size: 10rpx;
  color: #a16207;
}