.container {
  background: linear-gradient(180deg, #6b8e6b 0%, #8dac85 30%, #6b8e6b 100%);
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  margin-bottom: 8rpx;
  letter-spacing: 4rpx;
}

.info {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  box-sizing: border-box;
}

.game-area {
  position: relative;
  width: 92vw;
  height: 56vh;
  max-width: 710rpx;
  max-height: 620rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 24rpx;
  margin-bottom: 8rpx;
  border: 2rpx solid rgba(255,255,255,0.08);
  box-shadow: inset 0 0 60rpx rgba(0,0,0,0.1);
  box-sizing: border-box;
}

.card {
  position: absolute;
  width: 88rpx;
  height: 116rpx;
  border-radius: 12rpx;
  background: linear-gradient(160deg, #fffef5 0%, #f5f0e0 50%, #e8dcc8 100%);
  border: 1.5rpx solid rgba(180,140,80,0.3);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2), inset 0 1rpx 0 rgba(255,255,255,0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  transition: opacity 0.15s ease;
}

.card.covered {
  opacity: 0.45;
  filter: grayscale(0.3);
}

.card.picked {
  opacity: 0;
  pointer-events: none;
}

.card.removed {
  opacity: 0;
  pointer-events: none;
}

.card-img {
  width: 72rpx;
  height: 96rpx;
  filter: drop-shadow(0 1rpx 2rpx rgba(0,0,0,0.15));
}

.slots {
  display: flex;
  justify-content: center;
  gap: 4rpx;
  height: 130rpx;
  width: 92vw;
  max-width: 690rpx;
  padding: 14rpx 6rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(180deg, rgba(139,115,85,0.35), rgba(101,78,48,0.2));
  border: 2rpx solid rgba(180,140,80,0.3);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15), inset 0 1rpx 0 rgba(255,255,255,0.08);
  box-sizing: border-box;
}

.slot {
  flex: 1;
  max-width: 88rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: rgba(0,0,0,0.18);
  border: 1.5rpx dashed rgba(255,255,255,0.15);
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.slot-img {
  width: 72rpx;
  height: 96rpx;
  filter: drop-shadow(0 1rpx 3rpx rgba(0,0,0,0.2));
}

.slot.filled {
  background: linear-gradient(160deg, #fffef5 0%, #f5f0e0 50%, #e8dcc8 100%);
  border: 2rpx solid rgba(180,140,80,0.4);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2), inset 0 1rpx 0 rgba(255,255,255,0.5);
}

.btns {
  display: flex;
  gap: 16rpx;
  padding-top: 4rpx;
  padding-bottom: env(safe-area-inset-bottom, 8rpx);
}

.btn {
  padding: 14rpx 36rpx;
  background: linear-gradient(180deg, #5cb85c 0%, #449d44 100%);
  color: white;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.25), inset 0 1rpx 0 rgba(255,255,255,0.2);
  letter-spacing: 2rpx;
  transition: all 0.15s ease;
}

.btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
}
