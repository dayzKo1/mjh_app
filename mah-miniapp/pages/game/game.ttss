/* 游戏页面 - 横屏布局（原生横屏支持） */

/* ===== 容器 ===== */
.container {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: row;
  overflow: hidden;
  box-sizing: border-box;
}

/* ===== 左侧面板 - 游戏区域 ===== */
.left-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  min-width: 0;
}

/* ===== 右侧面板 - 控件 ===== */
.right-panel {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  gap: 16rpx;
  flex-shrink: 0;
  background: rgba(0, 0, 0, 0.2);
}

/* ===== 顶部状态栏 ===== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 20rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
}

.top-bar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f7e358;
}

.top-bar-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.top-stat {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.top-stat-divider {
  color: rgba(255, 255, 255, 0.3);
}

/* ===== 倒计时进度条 ===== */
.time-bar-container {
  padding: 8rpx 0;
}

.time-bar-bg {
  height: 16rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 8rpx;
  overflow: hidden;
}

.time-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease, background 0.3s ease;
  box-shadow: 0 0 8rpx rgba(76, 175, 80, 0.5);
}

/* ===== 游戏区域 ===== */
.game-area {
  flex: 1;
  position: relative;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  overflow: hidden;
}

/* ===== 暂存槽 - 横向排列 ===== */
.slots-bar {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
}

.slot {
  width: 48rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx dashed rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
}

.slot.filled {
  background: linear-gradient(170deg, #fffef9, #efe0c6);
  border: 2rpx solid rgba(200, 160, 80, 0.4);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.slot-img {
  width: 36rpx;
  height: 48rpx;
}

/* ===== 道具按钮 ===== */
.btns-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.btn-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.btn {
  height: 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(180deg, #f7e358, #c9a020);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.btn-text {
  font-size: 18rpx;
  color: #5a3e0b;
  font-weight: 600;
}

.btn-count {
  font-size: 16rpx;
  color: #5a3e0b;
  background: rgba(0, 0, 0, 0.15);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.btn-ad {
  height: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  border-radius: 8rpx;
}

.btn-ad-text {
  font-size: 14rpx;
  color: #fff;
}

/* ===== 底部导航 ===== */
.nav-bar {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}

.nav-item {
  padding: 10rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
}

.nav-text {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 卡片 ===== */
.card {
  position: absolute;
  width: 72rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: linear-gradient(170deg, #fffef9, #efe0c6);
  border: 2rpx solid rgba(200, 160, 80, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.card.covered {
  opacity: 0.35;
  filter: grayscale(0.3) brightness(0.6);
}

.card.picked, .card.removed {
  opacity: 0;
  pointer-events: none;
}

.card-img {
  width: 56rpx;
  height: 72rpx;
}

.hint-highlight {
  box-shadow: 0 0 16rpx 8rpx rgba(255, 235, 59, 0.9);
  animation: hintPulse 0.5s ease-in-out 3;
}

@keyframes hintPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 400rpx;
  background: linear-gradient(145deg, #2a2a4a, #1a1a2e);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f7e358;
  margin-bottom: 16rpx;
}

.win-modal .modal-title {
  color: #4CAF50;
}

.fail-modal .modal-title {
  color: #F44336;
}

.warning-modal .modal-title {
  color: #FF9800;
}

.modal-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
}

.modal-stats {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stat-label {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.5);
}

.stat-value {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.modal-btns {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.modal-btn {
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 12rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.1);
}

.modal-btn.primary {
  background: linear-gradient(180deg, #f7e358, #c9a020);
  color: #5a3e0b;
}

.ad-btn {
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  color: #fff;
}

.btn-ad-icon {
  font-size: 14rpx;
  margin-right: 6rpx;
}

/* ===== 道具面板 ===== */
.prop-panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1001;
}

.prop-panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.prop-panel-content {
  width: 480rpx;
  background: linear-gradient(145deg, #2a2a4a, #1a1a2e);
  border-radius: 20rpx;
  padding: 20rpx;
}

.prop-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.prop-panel-title {
  font-size: 22rpx;
  color: #f7e358;
}

.prop-panel-close {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

.prop-panel-body {
  max-height: 300rpx;
  overflow-y: auto;
}

.prop-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.prop-items-grid {
  max-height: 280rpx;
}

.prop-item {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
}

.prop-item.highlight {
  background: rgba(76, 175, 80, 0.2);
}

.prop-item-img {
  width: 52rpx;
  height: 68rpx;
}

.prop-item-label {
  font-size: 14rpx;
  color: rgba(255, 255, 255, 0.8);
}

.prop-item-count {
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.5);
}