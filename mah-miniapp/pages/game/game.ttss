/* ===== 容器 ===== */
.container {
  background: linear-gradient(180deg, #2d5a27 0%, #3d7a35 20%, #4a8f42 50%, #3d7a35 80%, #2d5a27 100%);
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 顶部状态栏：标题 + 信息合并一行 ===== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 14rpx 16rpx;
  margin-bottom: 10rpx;
  background: rgba(0,0,0,0.18);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  box-sizing: border-box;
}

.top-bar-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #f7e358;
  text-shadow: 0 2rpx 0 #8b6914, 0 4rpx 12rpx rgba(0,0,0,0.35);
  letter-spacing: 4rpx;
  flex-shrink: 0;
}

.top-bar-stats {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.top-stat {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.top-stat-time {
  color: #f7e358;
  font-weight: 800;
  min-width: 52rpx;
}

.top-stat-divider {
  font-size: 20rpx;
  color: rgba(255,255,255,0.25);
}

/* ===== 游戏区域 ===== */
.game-area {
  position: relative;
  width: 92vw;
  height: 56vh;
  max-width: 710rpx;
  max-height: 620rpx;
  background: radial-gradient(ellipse at center, rgba(255,255,255,0.06) 0%, rgba(0,0,0,0.15) 100%);
  border-radius: 28rpx;
  margin-bottom: 10rpx;
  border: 2rpx solid rgba(255,255,255,0.1);
  box-shadow:
    inset 0 2rpx 0 rgba(255,255,255,0.05),
    inset 0 -4rpx 20rpx rgba(0,0,0,0.15),
    0 8rpx 32rpx rgba(0,0,0,0.18);
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 卡片 ===== */
.card {
  position: absolute;
  width: 88rpx;
  height: 116rpx;
  border-radius: 14rpx;
  background: linear-gradient(170deg, #fffef9 0%, #faf5e8 40%, #efe0c6 100%);
  border: 2rpx solid rgba(200,160,80,0.35);
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,0.25),
    0 1rpx 0 rgba(255,255,255,0.7) inset,
    0 -1rpx 0 rgba(0,0,0,0.04) inset;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: opacity 0.15s ease, transform 0.1s ease;
}

.card.covered {
  opacity: 0.4;
  filter: grayscale(0.25) brightness(0.7);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.card.picked {
  opacity: 0;
  pointer-events: none;
}

.card.removed {
  opacity: 0;
  pointer-events: none;
}

.hint-highlight {
  box-shadow: 0 0 20rpx 10rpx rgba(255, 235, 59, 0.8) !important;
  animation: hintPulse 0.5s ease-in-out 3;
}

@keyframes hintPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.card-img {
  width: 72rpx;
  height: 96rpx;
  filter: drop-shadow(0 2rpx 3rpx rgba(0,0,0,0.2));
}

/* ===== 暂存槽 ===== */
.slots {
  display: flex;
  justify-content: center;
  gap: 6rpx;
  height: 132rpx;
  width: 92vw;
  max-width: 690rpx;
  padding: 14rpx 8rpx;
  margin-bottom: 10rpx;
  background: linear-gradient(180deg, rgba(60,35,15,0.45) 0%, rgba(40,22,8,0.55) 100%);
  border: 2rpx solid rgba(200,160,80,0.25);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 24rpx rgba(0,0,0,0.2),
    inset 0 1rpx 0 rgba(255,255,255,0.06),
    inset 0 -2rpx 6rpx rgba(0,0,0,0.2);
  box-sizing: border-box;
}

.slot {
  flex: 1;
  max-width: 88rpx;
  height: 102rpx;
  border-radius: 12rpx;
  background: rgba(0,0,0,0.25);
  border: 2rpx dashed rgba(255,255,255,0.12);
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.slot-img {
  width: 72rpx;
  height: 96rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.25));
}

.slot.filled {
  background: linear-gradient(170deg, #fffef9 0%, #faf5e8 40%, #efe0c6 100%);
  border: 2rpx solid rgba(200,160,80,0.45);
  box-shadow:
    0 3rpx 12rpx rgba(0,0,0,0.25),
    0 1rpx 0 rgba(255,255,255,0.6) inset;
}

/* ===== 按钮 ===== */
.btns {
  display: flex;
  gap: 12rpx;
  width: 92vw;
  max-width: 690rpx;
  padding-top: 6rpx;
}

.btn {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 80rpx;
  background: linear-gradient(180deg, #f7e358 0%, #e8c830 40%, #c9a020 100%);
  color: #5a3e0b;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,0.3),
    0 1rpx 0 rgba(255,255,255,0.3) inset;
  letter-spacing: 2rpx;
  transition: all 0.15s ease;
  box-sizing: border-box;
  white-space: nowrap;
}

.btn::after {
  border: none;
}

.btn:active {
  transform: scale(0.93);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.25);
}

/* ===== 底部导航：纯图标紧凑栏 ===== */
.nav-bar {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  width: 100%;
  margin-top: 10rpx;
  padding: 12rpx 8rpx;
  padding-bottom: calc(env(safe-area-inset-bottom, 8rpx) + 12rpx);
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 2rpx 8rpx;
  transition: all 0.15s ease;
}

.nav-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 3rpx 10rpx rgba(0,0,0,0.25);
  transition: all 0.2s ease;
}

.nav-icon-profile {
  background: linear-gradient(135deg, #667eea 0%, #5a4fcf 100%);
}

.nav-icon-rank {
  background: linear-gradient(135deg, #f5576c 0%, #e0405a 100%);
}

.nav-icon-withdraw {
  background: linear-gradient(135deg, #4facfe 0%, #3d8bfd 100%);
}

.nav-icon-invite {
  background: linear-gradient(135deg, #43e97b 0%, #2dce6e 100%);
}

.nav-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.nav-item:active .nav-icon {
  transform: scale(0.85);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

/* ===== 广告道具 ===== */
.ad-rewards {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 12rpx;
}

.ad-reward-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.4);
}

.ad-reward-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.ad-reward-icon {
  font-size: 32rpx;
}

.ad-reward-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

/* ===== 过关广告过渡界面 ===== */
.ad-transition {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  backdrop-filter: blur(10rpx);
}

.ad-transition-content {
  width: 600rpx;
  background: linear-gradient(180deg, #2d5a2d 0%, #1a3a1a 100%);
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.ad-transition-title {
  font-size: 48rpx;
  color: #f7e358;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-shadow: 0 2rpx 8rpx rgba(247, 227, 88, 0.3);
}

.ad-transition-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.ad-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ad-stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.ad-stat-value {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.ad-transition-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  margin: 24rpx 0;
}

.ad-transition-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 32rpx;
}

.ad-continue-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(180deg, #5cb85c, #449d44);
  box-shadow: 0 6rpx 20rpx rgba(76, 175, 80, 0.4);
  transition: all 0.2s ease;
}

.ad-continue-btn.disabled {
  background: linear-gradient(180deg, #555, #444);
  box-shadow: none;
  color: rgba(255, 255, 255, 0.4);
}

.ad-continue-btn:not(.disabled):active {
  transform: scale(0.96);
  box-shadow: 0 3rpx 10rpx rgba(76, 175, 80, 0.3);
}

/* ===== 侧边栏礼包入口 ===== */
.nav-icon-sidebar {
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  animation: sidebarGiftPulse 2s ease-in-out infinite;
}

.nav-icon-emoji {
  font-size: 36rpx;
}

@keyframes sidebarGiftPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}

/* ===== 侧边栏复访弹窗 ===== */
.sidebar-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
  backdrop-filter: blur(10rpx);
}

.sidebar-modal-content {
  width: 620rpx;
  background: linear-gradient(180deg, #2d5a27 0%, #1a3a1a 100%);
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  position: relative;
}

.sidebar-modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.sidebar-modal-title {
  font-size: 44rpx;
  color: #f7e358;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-shadow: 0 2rpx 8rpx rgba(247, 227, 88, 0.3);
}

.sidebar-modal-steps {
  margin-bottom: 32rpx;
}

.sidebar-step {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  text-align: left;
}

.sidebar-step-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f7e358, #e8c830);
  color: #5a3e0b;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.sidebar-step-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.sidebar-modal-reward {
  font-size: 32rpx;
  color: #f7e358;
  font-weight: bold;
  margin-bottom: 36rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.1);
}

.sidebar-modal-btns {
  display: flex;
  gap: 20rpx;
}

.sidebar-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  transition: all 0.15s ease;
}

.sidebar-btn:active {
  transform: scale(0.96);
}

.sidebar-btn-go {
  background: linear-gradient(180deg, #4facfe, #3d8bfd);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(61, 139, 253, 0.4);
}

.sidebar-btn-go.hidden {
  display: none;
}

.sidebar-btn-claim {
  background: linear-gradient(180deg, #f7e358, #e8c830);
  color: #5a3e0b;
  box-shadow: 0 6rpx 20rpx rgba(247, 227, 88, 0.4);
}

.sidebar-btn-claim.disabled {
  background: linear-gradient(180deg, #555, #444);
  color: rgba(255, 255, 255, 0.4);
  box-shadow: none;
}
