/* 游戏页面 - 麻将消消乐主题 */

page {
  height: 100%;
}

.container {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a3f 30%, #3d6b4f 60%, #1a472a 100%);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部信息栏 ===== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  padding-top: calc(12rpx + env(safe-area-inset-top));
  background: rgba(26, 71, 42, 0.95);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.top-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.top-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
}

.top-value {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.score-text {
  color: #f7e358;
  font-size: 28rpx;
  text-shadow: 0 2rpx 8rpx rgba(247, 227, 88, 0.5);
}

.top-timer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  margin-left: 16rpx;
}

.timer-bar {
  flex: 1;
  height: 16rpx;
  max-width: 200rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
  overflow: hidden;
}

.timer-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease, background 0.3s ease;
}

.timer-num {
  font-size: 18rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
  min-width: 40rpx;
}

/* ===== 福利按钮 ===== */
.gift-btn {
  position: fixed;
  top: calc(80rpx + env(safe-area-inset-top));
  left: 16rpx;
  z-index: 90;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  border-radius: 16rpx;
  box-shadow: 0 3rpx 12rpx rgba(247, 147, 30, 0.4);
  animation: giftPulse 2s ease-in-out infinite;
}

.gift-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
}

@keyframes giftPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

/* ===== 中央游戏区域 ===== */
.game-area {
  position: absolute;
  width: 640rpx;
  height: 520rpx;
  left: 0;
  right: 0;
  top: calc(60rpx + env(safe-area-inset-top));
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  margin: auto;
  overflow: visible;
}

/* ===== 麻将牌卡片 ===== */
.card {
  position: absolute;
  width: 72rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: linear-gradient(170deg, #fffef9, #faf5e8, #efe0c6);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow:
    0 3rpx 12rpx rgba(0, 0, 0, 0.15),
    0 6rpx 20rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.card:active {
  transform: scale(0.92);
}

.card-img {
  width: 56rpx;
  height: 72rpx;
}

.card.covered {
  opacity: 0.6;
  filter: brightness(0.7);
}

.card.removed {
  opacity: 0;
  transform: scale(0.5);
  pointer-events: none;
}

.card.picked {
  opacity: 0;
  transform: scale(0.8) translateY(-20rpx);
  pointer-events: none;
}

.card.hint-highlight {
  box-shadow:
    0 0 0 4rpx #22c55e,
    0 0 20rpx 8rpx rgba(34, 197, 94, 0.5),
    0 3rpx 12rpx rgba(0, 0, 0, 0.15);
  animation: hintFlash 0.6s ease-in-out infinite;
}

@keyframes hintFlash {
  0%, 100% { box-shadow: 0 0 0 4rpx #22c55e, 0 0 20rpx 8rpx rgba(34, 197, 94, 0.5); }
  50% { box-shadow: 0 0 0 6rpx #22c55e, 0 0 30rpx 12rpx rgba(34, 197, 94, 0.7); }
}

/* ===== 底部操作区 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(26, 71, 42, 0.95);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* 暂存槽 */
.slots-section {
  flex: 1;
  max-width: 400rpx;
}

.slots-wrap {
  display: flex;
  gap: 8rpx;
}

.slot {
  width: 56rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.slot.filled {
  background: linear-gradient(170deg, #fffef9, #faf5e8);
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.slot-img {
  width: 44rpx;
  height: 56rpx;
}

/* 道具按钮 */
.props-section {
  display: flex;
  gap: 12rpx;
}

.prop-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  min-width: 70rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 14rpx;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.2);
}

.prop-btn:active {
  transform: scale(0.95);
}

.prop-name {
  font-size: 18rpx;
  font-weight: 700;
  color: #1a472a;
}

.prop-num {
  font-size: 22rpx;
  font-weight: 900;
  color: #22c55e;
}

.prop-ad {
  font-size: 14rpx;
  color: #f7931e;
  margin-top: 4rpx;
}

/* ===== 弹窗 ===== */
.panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.panel-content {
  width: 85%;
  max-height: 70%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.panel-inner {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
}

.panel-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1a472a;
  text-align: center;
  margin-bottom: 16rpx;
}

.panel-scroll {
  max-height: 300rpx;
}

.panel-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.panel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  min-width: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.panel-item:active {
  transform: scale(0.95);
  background: #f0f5f0;
}

.panel-img {
  width: 48rpx;
  height: 64rpx;
}

.panel-name {
  font-size: 16rpx;
  font-weight: 600;
  color: #1a472a;
  margin-top: 6rpx;
}

.panel-count {
  font-size: 12rpx;
  color: #6b7280;
}

.panel-close {
  padding: 16rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #6b7280;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 12rpx;
  margin-top: 16rpx;
}

/* ===== 模态弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.7);
}

.modal-box {
  width: 80%;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  text-align: center;
}

.modal-box.win {
  background: linear-gradient(170deg, #fffef9, #fff);
}

.modal-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #1a472a;
  margin-bottom: 16rpx;
}

.modal-msg {
  font-size: 20rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.modal-btn.secondary {
  background: rgba(0, 0, 0, 0.1);
  color: #6b7280;
}

.modal-btn.primary {
  background: #22c55e;
  color: #fff;
  box-shadow: 0 3rpx 12rpx rgba(34, 197, 94, 0.3);
}

.modal-btn:active {
  transform: scale(0.95);
}

/* ===== 加载遮罩 ===== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 71, 42, 0.9);
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-spin {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: conic-gradient(#22c55e 0deg 270deg, transparent 270deg 360deg);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
}