<!-- 游戏页面 - 羊了个羊玩法 -->
<view class="container">
  <view class="header">麻将消消乐</view>

  <view class="info">
    <text>第{{level}}关</text>
    <text>得分:{{score}}</text>
    <text>用时:{{time}}s</text>
  </view>

  <!-- 游戏区域 -->
  <view class="game-area">
    <view
      tt:for="{{cards}}"
      tt:key="id"
      class="card {{item.isCover ? 'covered' : ''}} {{item.status === 2 ? 'removed' : ''}} {{item.status === 1 ? 'picked' : ''}} {{hintCardId === item.id ? 'hint-highlight' : ''}}"
      data-index="{{index}}"
      bindtap="onCardTap"
      animation="{{cardAnimations[item.id]}}"
      style="left:{{item.x}}rpx; top:{{item.y}}rpx; z-index:{{10 + item.layer}};"
    >
      <image
        class="card-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 暂存槽 -->
  <view class="slots">
    <view
      tt:for="{{slots}}"
      tt:key="index"
      class="slot {{item ? 'filled' : ''}}"
      animation="{{slotAnimations[index]}}"
    >
      <image
        tt:if="{{item}}"
        class="slot-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 按钮 -->
  <view class="btns">
    <view class="btn" bindtap="undo">撤销</view>
    <view class="btn" bindtap="hint">提示({{hintCount}})</view>
    <view class="btn" bindtap="shuffle">洗牌</view>
    <view class="btn" bindtap="restartGame">重玩</view>
  </view>

  <!-- 看广告获道具 -->
  <view class="ad-rewards" tt:if="{{gameOverState}}">
    <view class="ad-reward-btn" bindtap="watchAdForRevive">
      <text class="ad-reward-icon">🎬</text>
      <text class="ad-reward-text">看广告复活</text>
    </view>
  </view>

  <!-- 导航入口 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="goToProfile">
      <view class="nav-icon nav-icon-profile">
        <text class="nav-icon-emoji">👤</text>
      </view>
      <text class="nav-text">我的</text>
    </view>
    <view class="nav-item" bindtap="goToRank">
      <view class="nav-icon nav-icon-rank">
        <text class="nav-icon-emoji">🏆</text>
      </view>
      <text class="nav-text">排行</text>
    </view>
    <view class="nav-item" bindtap="goToWithdraw">
      <view class="nav-icon nav-icon-withdraw">
        <text class="nav-icon-emoji">💰</text>
      </view>
      <text class="nav-text">提现</text>
    </view>
    <view class="nav-item" bindtap="goToInvite">
      <view class="nav-icon nav-icon-invite">
        <text class="nav-icon-emoji">🎁</text>
      </view>
      <text class="nav-text">邀请</text>
    </view>
  </view>

  <!-- 过关广告过渡界面 -->
  <view class="ad-transition" tt:if="{{showAdTransition}}">
    <view class="ad-transition-content">
      <view class="ad-transition-title">🎉 恭喜过关!</view>
      <view class="ad-transition-stats">
        <view class="ad-stat-item">
          <text class="ad-stat-label">得分</text>
          <text class="ad-stat-value">{{score}}</text>
        </view>
        <view class="ad-stat-item">
          <text class="ad-stat-label">用时</text>
          <text class="ad-stat-value">{{time}}秒</text>
        </view>
        <view class="ad-stat-item">
          <text class="ad-stat-label">关卡</text>
          <text class="ad-stat-value">第{{level}}关</text>
        </view>
      </view>
      <view class="ad-transition-divider"></view>
      <view class="ad-transition-tip" tt:if="{{adCountdown > 0}}">
        广告 {{adCountdown}}s 后可继续
      </view>
      <view
        class="ad-continue-btn {{adCountdown > 0 ? 'disabled' : ''}}"
        bindtap="continueToNextLevel"
      >
        {{adCountdown > 0 ? '请等待 ' + adCountdown + 's' : '继续闯关 →'}}
      </view>
    </view>
  </view>
</view>
