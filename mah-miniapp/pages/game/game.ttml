<!-- 游戏页面 - 羊了个羊玩法 -->
<view class="container">
  <view class="header">麻将消消乐</view>

  <view class="info">
    <text>第{{level}}关</text>
    <text>得分:{{score}}</text>
    <text>用时:{{time}}s</text>
  </view>

  <!-- 游戏区域 -->
  <view class="game-area">
    <view
      tt:for="{{cards}}"
      tt:key="id"
      class="card {{item.isCover ? 'covered' : ''}} {{item.status === 2 ? 'removed' : ''}} {{item.status === 1 ? 'picked' : ''}}"
      data-index="{{index}}"
      bindtap="onCardTap"
      animation="{{cardAnimations[item.id]}}"
      style="left:{{item.x}}rpx; top:{{item.y}}rpx; z-index:{{10 + item.layer}};"
    >
      <image
        class="card-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 暂存槽 -->
  <view class="slots">
    <view
      tt:for="{{slots}}"
      tt:key="index"
      class="slot {{item ? 'filled' : ''}}"
      animation="{{slotAnimations[index]}}"
    >
      <image
        tt:if="{{item}}"
        class="slot-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 按钮 -->
  <view class="btns">
    <view class="btn" bindtap="undo">撤销</view>
    <view class="btn" bindtap="shuffle">洗牌</view>
    <view class="btn" bindtap="restartGame">重玩</view>
  </view>

  <!-- 导航入口 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="goToProfile">
      <view class="nav-icon nav-icon-profile">
        <text class="nav-icon-emoji">👤</text>
      </view>
      <text class="nav-text">我的</text>
    </view>
    <view class="nav-item" bindtap="goToRank">
      <view class="nav-icon nav-icon-rank">
        <text class="nav-icon-emoji">🏆</text>
      </view>
      <text class="nav-text">排行</text>
    </view>
    <view class="nav-item" bindtap="goToWithdraw">
      <view class="nav-icon nav-icon-withdraw">
        <text class="nav-icon-emoji">💰</text>
      </view>
      <text class="nav-text">提现</text>
    </view>
    <view class="nav-item" bindtap="goToInvite">
      <view class="nav-icon nav-icon-invite">
        <text class="nav-icon-emoji">🎁</text>
      </view>
      <text class="nav-text">邀请</text>
    </view>
  </view>
</view>
