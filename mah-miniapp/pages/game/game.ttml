<!-- 游戏页面 - 羊了个羊玩法 -->
<view class="container">
  <!-- 顶部状态栏：标题 + 信息合并一行 -->
  <view class="top-bar">
    <text class="top-bar-title">麻将消消乐</text>
    <view class="top-bar-stats">
      <text class="top-stat">第{{level}}关</text>
      <text class="top-stat-divider">|</text>
      <text class="top-stat">{{score}}分</text>
      <text class="top-stat-divider">|</text>
      <text class="top-stat top-stat-time">{{time}}s</text>
    </view>
  </view>

  <!-- 游戏区域 -->
  <view class="game-area">
    <view
      tt:for="{{cards}}"
      tt:key="id"
      class="card {{item.isCover ? 'covered' : ''}} {{item.status === 2 ? 'removed' : ''}} {{item.status === 1 ? 'picked' : ''}} {{hintCardId === item.id ? 'hint-highlight' : ''}}"
      data-index="{{index}}"
      bindtap="onCardTap"
      animation="{{cardAnimations[item.id]}}"
      style="left:{{item.x}}rpx; top:{{item.y}}rpx; z-index:{{10 + item.layer}};"
    >
      <image
        class="card-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 暂存槽 -->
  <view class="slots">
    <view
      tt:for="{{slots}}"
      tt:key="index"
      class="slot {{item ? 'filled' : ''}}"
      animation="{{slotAnimations[index]}}"
    >
      <image
        tt:if="{{item}}"
        class="slot-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 按钮 -->
  <view class="btns">
    <view class="btn" bindtap="undo">撤销</view>
    <view class="btn" bindtap="hint">提示({{hintCount}})</view>
    <view class="btn" bindtap="shuffle">洗牌</view>
    <view class="btn" bindtap="restartGame">重玩</view>
  </view>

  <!-- 看广告获道具 -->
  <view class="ad-rewards" tt:if="{{gameOverState}}">
    <view class="ad-reward-btn" bindtap="watchAdForRevive">
      <text class="ad-reward-icon">🎬</text>
      <text class="ad-reward-text">看广告复活</text>
    </view>
  </view>

  <!-- 底部导航：纯图标紧凑栏 -->
  <view class="nav-bar">
    <view class="nav-item" tt:if="{{showSidebarGift}}" bindtap="onSidebarGiftTap">
      <view class="nav-icon nav-icon-sidebar">
        <text class="nav-icon-emoji">🎁</text>
      </view>
    </view>
    <view class="nav-item" bindtap="goToProfile">
      <view class="nav-icon nav-icon-profile">
        <image class="nav-icon-img" src="/images/icons/nav_profile.png" mode="aspectFit" />
      </view>
    </view>
    <view class="nav-item" bindtap="goToRank">
      <view class="nav-icon nav-icon-rank">
        <image class="nav-icon-img" src="/images/icons/nav_rank.png" mode="aspectFit" />
      </view>
    </view>
    <view class="nav-item" bindtap="goToWithdraw">
      <view class="nav-icon nav-icon-withdraw">
        <image class="nav-icon-img" src="/images/icons/nav_withdraw.png" mode="aspectFit" />
      </view>
    </view>
    <view class="nav-item" bindtap="goToInvite">
      <view class="nav-icon nav-icon-invite">
        <image class="nav-icon-img" src="/images/icons/nav_invite.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 过关广告过渡界面 -->
  <view class="ad-transition" tt:if="{{showAdTransition}}">
    <view class="ad-transition-content">
      <view class="ad-transition-title">🎉 恭喜过关!</view>
      <view class="ad-transition-stats">
        <view class="ad-stat-item">
          <text class="ad-stat-label">得分</text>
          <text class="ad-stat-value">{{score}}</text>
        </view>
        <view class="ad-stat-item">
          <text class="ad-stat-label">用时</text>
          <text class="ad-stat-value">{{time}}秒</text>
        </view>
        <view class="ad-stat-item">
          <text class="ad-stat-label">关卡</text>
          <text class="ad-stat-value">第{{level}}关</text>
        </view>
      </view>
      <view class="ad-transition-divider"></view>
      <view class="ad-transition-tip" tt:if="{{adCountdown > 0}}">
        广告 {{adCountdown}}s 后可继续
      </view>
      <view
        class="ad-continue-btn {{adCountdown > 0 ? 'disabled' : ''}}"
        bindtap="continueToNextLevel"
      >
        {{adCountdown > 0 ? '请等待 ' + adCountdown + 's' : '继续闯关 →'}}
      </view>
    </view>
  </view>

  <!-- 侧边栏复访引导弹窗 -->
  <view class="sidebar-modal" tt:if="{{showSidebarModal}}">
    <view class="sidebar-modal-content">
      <view class="sidebar-modal-close" bindtap="closeSidebarModal">✕</view>
      <view class="sidebar-modal-title">🎁 侧边栏入口奖励</view>
      <view class="sidebar-modal-steps">
        <view class="sidebar-step">
          <view class="sidebar-step-num">1</view>
          <text class="sidebar-step-text">点击下方「去首页侧边栏」按钮</text>
        </view>
        <view class="sidebar-step">
          <view class="sidebar-step-num">2</view>
          <text class="sidebar-step-text">在侧边栏，点击「麻将消消乐」</text>
        </view>
        <view class="sidebar-step">
          <view class="sidebar-step-num">3</view>
          <text class="sidebar-step-text">返回游戏，领取奖励</text>
        </view>
      </view>
      <view class="sidebar-modal-reward">奖励：提示次数 +3</view>
      <view class="sidebar-modal-btns">
        <view
          class="sidebar-btn sidebar-btn-go {{sidebarTaskDone ? 'hidden' : ''}}"
          bindtap="goToSidebar"
        >
          去首页侧边栏
        </view>
        <view
          class="sidebar-btn sidebar-btn-claim {{sidebarTaskDone ? '' : 'disabled'}}"
          bindtap="claimSidebarReward"
        >
          {{sidebarTaskDone ? '立即领奖' : '未完成'}}
        </view>
      </view>
    </view>
  </view>
</view>
