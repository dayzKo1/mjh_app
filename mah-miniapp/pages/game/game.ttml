<!-- 游戏页面 - 包了个包主题 -->
<view class="container">
  <!-- 左上角：积分显示 -->
  <view class="corner corner-left-top">
    <view class="score-box">
      <text class="score-label">积分</text>
      <text class="score-value">{{score}}</text>
    </view>
    <view class="level-box">
      <text class="level-text">{{levelName}}</text>
    </view>
  </view>

  <!-- 右上角：进度条 -->
  <view class="corner corner-right-top">
    <view class="progress-box">
      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{timeProgress}}%; background: {{timeProgress > 30 ? '#22c55e' : timeProgress > 15 ? '#f59e0b' : '#ef4444'}}"></view>
      </view>
      <text class="progress-text">{{timeProgress}}%</text>
    </view>
  </view>

  <!-- 中央游戏区域 - 麻将牌 -->
  <view class="game-area">
    <view
      tt:for="{{cards}}"
      tt:key="id"
      class="card {{item.isCover ? 'covered' : ''}} {{item.status === 2 ? 'removed' : ''}} {{item.status === 1 ? 'picked' : ''}} {{hintCardId === item.id ? 'hint-highlight' : ''}}"
      data-index="{{index}}"
      bindtap="onCardTap"
      style="left:{{item.x}}rpx; top:{{item.y}}rpx; z-index:{{10 + item.layer}};"
    >
      <image
        class="card-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 左下角：暂存槽 -->
  <view class="corner corner-left-bottom">
    <view class="slots-container">
      <view
        tt:for="{{slots}}"
        tt:key="index"
        class="slot {{item ? 'filled' : ''}}"
        data-index="{{index}}"
      >
        <image
          tt:if="{{item}}"
          class="slot-img"
          src="/images/{{item.icon}}.png"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>

  <!-- 右下角：道具按钮 -->
  <view class="corner corner-right-bottom">
    <view class="props-container">
      <view class="prop-item">
        <view class="prop-btn" bindtap="useUndoOrAd">
          <text class="prop-btn-text">回退</text>
          <text class="prop-btn-count">{{undoCount}}</text>
        </view>
        <view class="prop-ad-btn" tt:if="{{undoCount <= 0}}" bindtap="watchAdForUndo">
          <text class="prop-ad-text">看广告</text>
        </view>
      </view>
      <view class="prop-item">
        <view class="prop-btn" bindtap="useFindOrAd">
          <text class="prop-btn-text">寻找</text>
          <text class="prop-btn-count">{{findCount}}</text>
        </view>
        <view class="prop-ad-btn" tt:if="{{findCount <= 0}}" bindtap="watchAdForFind">
          <text class="prop-ad-text">看广告</text>
        </view>
      </view>
      <view class="prop-item">
        <view class="prop-btn" bindtap="useBombOrAd">
          <text class="prop-btn-text">炸弹</text>
          <text class="prop-btn-count">{{bombCount}}</text>
        </view>
        <view class="prop-ad-btn" tt:if="{{bombCount <= 0}}" bindtap="watchAdForBomb">
          <text class="prop-ad-text">看广告</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 过关弹窗 -->
  <view class="modal-overlay" tt:if="{{showWinModal}}">
    <view class="modal-content win-modal">
      <text class="modal-title">恭喜过关</text>
      <view class="modal-stats">
        <view class="stat-item">
          <text class="stat-label">得分</text>
          <text class="stat-value">{{score}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">关卡</text>
          <text class="stat-value">{{levelName}}</text>
        </view>
      </view>
      <view class="modal-btns">
        <view class="modal-btn primary" bindtap="nextLevel">下一关</view>
        <view class="modal-btn" bindtap="backToLevels">返回关卡</view>
      </view>
    </view>
  </view>

  <!-- 倒计时警告弹窗 -->
  <view class="modal-overlay" tt:if="{{showTimeWarningModal}}">
    <view class="modal-content warning-modal">
      <text class="modal-title">时间即将耗尽</text>
      <text class="modal-desc">看广告可增加30秒时间</text>
      <view class="modal-btns">
        <view class="modal-btn primary ad-btn" bindtap="watchAdForTime">
          <text class="btn-ad-text">看广告 +30s</text>
        </view>
        <view class="modal-btn" bindtap="continueWithoutAd">继续游戏</view>
      </view>
    </view>
  </view>

  <!-- 游戏失败弹窗 -->
  <view class="modal-overlay" tt:if="{{showFailModal}}">
    <view class="modal-content fail-modal">
      <text class="modal-title">游戏失败</text>
      <view class="modal-stats">
        <view class="stat-item">
          <text class="stat-label">得分</text>
          <text class="stat-value">{{score}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">关卡</text>
          <text class="stat-value">{{levelName}}</text>
        </view>
      </view>
      <text class="modal-desc">看广告可从当前进度继续</text>
      <view class="modal-btns">
        <view class="modal-btn primary ad-btn" bindtap="watchAdToRevive">
          <text class="btn-ad-text">看广告复活</text>
        </view>
        <view class="modal-btn" bindtap="restartGame">重新开始</view>
        <view class="modal-btn" bindtap="backToLevels">返回关卡</view>
      </view>
    </view>
  </view>

  <!-- 道具选择面板 -->
  <view class="prop-panel" tt:if="{{showUndoPanel || showFindPanel || showBombPanel}}">
    <view class="prop-panel-mask" bindtap="closeAllPanels"></view>
    <view class="prop-panel-content">
      <view class="prop-panel-header">
        <text class="prop-panel-title">{{showUndoPanel ? '选择要取回的牌' : showFindPanel ? '选择要寻找的类型' : '选择要炸掉的牌'}}</text>
        <view class="prop-panel-close" bindtap="closeAllPanels">X</view>
      </view>
      <view class="prop-panel-body">
        <view class="prop-items" tt:if="{{showUndoPanel}}">
          <view
            tt:for="{{undoCandidates}}"
            tt:key="id"
            class="prop-item-card"
            data-index="{{index}}"
            bindtap="selectUndoItem"
          >
            <image class="prop-item-img" src="/images/{{item.icon}}.png" mode="aspectFit" />
            <text class="prop-item-label">{{item.iconName}}</text>
          </view>
        </view>
        <view class="prop-items" tt:if="{{showFindPanel}}">
          <view
            tt:for="{{findCandidates}}"
            tt:key="icon"
            class="prop-item-card {{item.canEliminate ? 'highlight' : ''}}"
            data-index="{{index}}"
            bindtap="selectFindItem"
          >
            <image class="prop-item-img" src="/images/{{item.icon}}.png" mode="aspectFit" />
            <text class="prop-item-label">{{item.iconName}}</text>
            <text class="prop-item-count">槽{{item.slotCount}} 场{{item.clickableCount}}</text>
          </view>
        </view>
        <view class="prop-items prop-items-grid" tt:if="{{showBombPanel}}">
          <view
            tt:for="{{bombCandidates}}"
            tt:key="id"
            class="prop-item-card"
            data-index="{{index}}"
            bindtap="selectBombItem"
          >
            <image class="prop-item-img" src="/images/{{item.icon}}.png" mode="aspectFit" />
            <text class="prop-item-label">{{item.iconName}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>