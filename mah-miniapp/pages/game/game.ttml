<!-- 游戏页面 - 麻将消消乐主题 -->
<view class="container">
  <!-- 顶部信息栏：关卡 + 积分 + 进度条 -->
  <view class="top-bar">
    <view class="top-item">
      <text class="top-label">关卡</text>
      <text class="top-value">{{levelName}}</text>
    </view>
    <view class="top-item">
      <text class="top-label">积分</text>
      <text class="top-value score-text">{{score}}</text>
    </view>
    <view class="top-timer">
      <text class="top-label">时间</text>
      <view class="timer-bar">
        <view class="timer-fill" style="width: {{timeProgress}}%; background: {{timeProgress > 30 ? '#22c55e' : timeProgress > 15 ? '#f59e0b' : '#ef4444'}}"></view>
      </view>
      <text class="timer-num">{{timeProgress}}%</text>
    </view>
  </view>

  <!-- 左上角：福利入口 -->
  <view class="gift-btn" tt:if="{{showSidebarGift}}" bindtap="onSidebarGiftTap">
    <text class="gift-text">福利</text>
  </view>

  <!-- 中央游戏区域 - 麻将牌 -->
  <view class="game-area">
    <view
      tt:for="{{cards}}"
      tt:key="id"
      class="card {{item.isCover ? 'covered' : ''}} {{item.status === 2 ? 'removed' : ''}} {{item.status === 1 ? 'picked' : ''}} {{hintCardId === item.id ? 'hint-highlight' : ''}}"
      data-index="{{index}}"
      bindtap="onCardTap"
      style="left:{{item.x}}rpx; top:{{item.y}}rpx; z-index:{{10 + item.layer}};"
    >
      <image
        class="card-img"
        src="/images/{{item.icon}}.png"
        mode="aspectFit"
      />
    </view>
  </view>

  <!-- 底部操作区：暂存槽 + 道具 -->
  <view class="bottom-bar">
    <!-- 暂存槽 -->
    <view class="slots-section">
      <view class="slots-wrap">
        <view
          tt:for="{{slots}}"
          tt:key="index"
          class="slot {{item ? 'filled' : ''}}"
          data-index="{{index}}"
        >
          <image
            tt:if="{{item}}"
            class="slot-img"
            src="/images/{{item.icon}}.png"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>

    <!-- 道具按钮 -->
    <view class="props-section">
      <view class="prop-btn" bindtap="useUndoOrAd">
        <text class="prop-name">回退</text>
        <text class="prop-num">{{undoCount}}</text>
        <text class="prop-ad" tt:if="{{undoCount <= 0}}" bindtap="watchAdForUndo">+广告</text>
      </view>
      <view class="prop-btn" bindtap="useFindOrAd">
        <text class="prop-name">寻找</text>
        <text class="prop-num">{{findCount}}</text>
        <text class="prop-ad" tt:if="{{findCount <= 0}}" bindtap="watchAdForFind">+广告</text>
      </view>
      <view class="prop-btn" bindtap="useBombOrAd">
        <text class="prop-name">炸弹</text>
        <text class="prop-num">{{bombCount}}</text>
        <text class="prop-ad" tt:if="{{bombCount <= 0}}" bindtap="watchAdForBomb">+广告</text>
      </view>
    </view>
  </view>

  <!-- 道具选择弹窗 -->
  <view class="panel-overlay" tt:if="{{showUndoPanel || showFindPanel || showBombPanel}}" bindtap="closeAllPanels">
    <view class="panel-content" catchtap="stopPropagation">
      <!-- 回退面板 -->
      <view tt:if="{{showUndoPanel}}" class="panel-inner">
        <text class="panel-title">选择要取回的牌</text>
        <scroll-view class="panel-scroll" scroll-y="true">
          <view class="panel-grid">
            <view
              tt:for="{{undoCandidates}}"
              tt:key="id"
              class="panel-item"
              data-index="{{index}}"
              bindtap="selectUndoItem"
            >
              <image class="panel-img" src="/images/{{item.icon}}.png" mode="aspectFit"/>
              <text class="panel-name">{{item.iconName}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="panel-close" bindtap="closeAllPanels">取消</view>
      </view>

      <!-- 寻找面板 -->
      <view tt:if="{{showFindPanel}}" class="panel-inner">
        <text class="panel-title">选择要高亮的牌类型</text>
        <scroll-view class="panel-scroll" scroll-y="true">
          <view class="panel-grid">
            <view
              tt:for="{{findCandidates}}"
              tt:key="icon"
              class="panel-item"
              data-index="{{index}}"
              bindtap="selectFindItem"
            >
              <image class="panel-img" src="/images/{{item.icon}}.png" mode="aspectFit"/>
              <text class="panel-name">{{item.iconName}}</text>
              <text class="panel-count">暂存{{item.slotCount}}张</text>
            </view>
          </view>
        </scroll-view>
        <view class="panel-close" bindtap="closeAllPanels">取消</view>
      </view>

      <!-- 炸弹面板 -->
      <view tt:if="{{showBombPanel}}" class="panel-inner">
        <text class="panel-title">选择要炸掉的牌</text>
        <scroll-view class="panel-scroll" scroll-y="true">
          <view class="panel-grid">
            <view
              tt:for="{{bombCandidates}}"
              tt:key="id"
              class="panel-item"
              data-index="{{index}}"
              bindtap="selectBombItem"
            >
              <image class="panel-img" src="/images/{{item.icon}}.png" mode="aspectFit"/>
              <text class="panel-name">{{item.iconName}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="panel-close" bindtap="closeAllPanels">取消</view>
      </view>
    </view>
  </view>

  <!-- 时间警告弹窗 -->
  <view class="modal-overlay" tt:if="{{showTimeWarningModal}}">
    <view class="modal-box">
      <text class="modal-title">时间不足</text>
      <text class="modal-msg">剩余时间少于15秒，是否观看广告延长?</text>
      <view class="modal-btns">
        <view class="modal-btn secondary" bindtap="closeTimeWarningModal">放弃</view>
        <view class="modal-btn primary" bindtap="watchAdForTime">延长30秒</view>
      </view>
    </view>
  </view>

  <!-- 游戏失败弹窗 -->
  <view class="modal-overlay" tt:if="{{showFailModal}}">
    <view class="modal-box">
      <text class="modal-title">游戏失败</text>
      <text class="modal-msg">关卡: {{levelName}} | 得分: {{score}}</text>
      <view class="modal-btns">
        <view class="modal-btn secondary" bindtap="backToLevels">返回</view>
        <view class="modal-btn primary" bindtap="watchAdToRevive" tt:if="{{!hasUsedReviveAd}}">复活</view>
        <view class="modal-btn primary" bindtap="restartGame" tt:if="{{hasUsedReviveAd}}">重来</view>
      </view>
    </view>
  </view>

  <!-- 过关弹窗 -->
  <view class="modal-overlay" tt:if="{{showWinModal}}">
    <view class="modal-box win">
      <text class="modal-title">恭喜过关</text>
      <text class="modal-msg">关卡: {{levelName}} | 得分: {{score}}</text>
      <view class="modal-btns">
        <view class="modal-btn secondary" bindtap="backToLevels">返回</view>
        <view class="modal-btn primary" bindtap="nextLevel">下一关</view>
      </view>
    </view>
  </view>

  <!-- 侧边栏福利弹窗 -->
  <view class="modal-overlay" tt:if="{{showSidebarModal}}">
    <view class="modal-box">
      <text class="modal-title">福利任务</text>
      <text class="modal-msg">完成侧边栏任务可获得奖励</text>
      <view class="modal-btns">
        <view class="modal-btn secondary" bindtap="closeSidebarModal">关闭</view>
        <view class="modal-btn primary" bindtap="goSidebarTask">去完成</view>
      </view>
    </view>
  </view>

  <!-- 加载遮罩 -->
  <view class="loading-overlay" tt:if="{{loading}}">
    <view class="loading-box">
      <view class="loading-spin"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>