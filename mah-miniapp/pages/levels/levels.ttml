<!-- 关卡选择页面 - 包了个包主题 -->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-left">
      <view class="logo-mini">
        <text class="logo-icon-text">B</text>
      </view>
      <text class="title">包了个包</text>
    </view>
    <view class="header-right">
      <view class="score-badge">
        <text class="score-label">总积分</text>
        <text class="score-value">{{totalScore}}</text>
      </view>
    </view>
  </view>

  <!-- 关卡网格 -->
  <view class="levels-container">
    <view class="levels-grid">
      <view
        tt:for="{{levels}}"
        tt:key="id"
        class="level-item {{item.isUnlocked ? 'unlocked' : 'locked'}}"
        data-id="{{item.id}}"
        bindtap="onLevelTap"
      >
        <!-- 关卡编号 - 面包形状 -->
        <view class="level-number" style="background: {{item.isUnlocked ? item.color : '#9ca3af'}}">
          <text class="level-num-text">{{item.id}}</text>
        </view>

        <!-- 关卡信息 -->
        <view class="level-info">
          <text class="level-name">{{item.name}}</text>
          
          <!-- 星级评价 - 面包星 -->
          <view class="level-stars" tt:if="{{item.isCompleted}}">
            <text class="star {{item.stars >= 1 ? 'star-filled' : ''}}">* </text>
            <text class="star {{item.stars >= 2 ? 'star-filled' : ''}}">* </text>
            <text class="star {{item.stars >= 3 ? 'star-filled' : ''}}">* </text>
          </view>

          <!-- 最高分 -->
          <text class="level-score" tt:if="{{item.isCompleted}}">{{item.bestScore}}分</text>

          <!-- 锁定提示 -->
          <text class="level-locked-info" tt:if="{{!item.isUnlocked}}">
            未解锁
          </text>
        </view>

        <!-- 锁定图标 -->
        <view class="lock-icon" tt:if="{{!item.isUnlocked}}">
          <text class="lock-text">X</text>
        </view>

        <!-- 已通关标记 -->
        <view class="completed-mark" tt:if="{{item.isCompleted}}">
          <text class="completed-text">通关</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="footer">
    <view class="nav-btn" bindtap="goToProfile">
      <text class="nav-btn-icon">U</text>
      <text class="nav-btn-text">我的</text>
    </view>
    <view class="nav-btn" bindtap="goToRank">
      <text class="nav-btn-icon">R</text>
      <text class="nav-btn-text">排行</text>
    </view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-mask" tt:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载关卡...</text>
    </view>
  </view>
</view>