<!-- 关卡选择页面 - 麻将消消乐主题 -->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-left">
      <view class="logo-mini">
        <text class="logo-icon-text">M</text>
      </view>
      <text class="title">麻将消消乐</text>
    </view>
    <view class="header-right">
      <view class="score-badge">
        <text class="score-label">总积分</text>
        <text class="score-value">{{totalScore}}</text>
      </view>
    </view>
  </view>

  <!-- 分支选择（入门/挑战） -->
  <view class="branch-tabs">
    <view
      tt:for="{{branches}}"
      tt:key="id"
      class="branch-tab {{currentBranch === item.id ? 'active' : ''}}"
      data-branch="{{item.id}}"
      bindtap="switchBranch"
    >
      <text class="branch-tab-text" style="color: {{currentBranch === item.id ? item.color : '#9ca3af'}}">{{item.name}}</text>
    </view>
  </view>

  <!-- 线路和关卡 -->
  <scroll-view class="levels-container" scroll-y="true">
    <view class="lines-wrapper">
      <view tt:for="{{lines}}" tt:key="id" class="line-section">
        <!-- 线路标题 -->
        <view class="line-header">
          <view class="line-indicator" style="background: {{item.color}}"></view>
          <text class="line-name">{{item.name}}</text>
        </view>

        <!-- 该线路的关卡 -->
        <view class="levels-row">
          <view
            tt:for="{{item.levels}}"
            tt:for-item="level"
            tt:key="id"
            class="level-card {{level.isUnlocked ? 'unlocked' : 'locked'}}"
            data-id="{{level.id}}"
            bindtap="onLevelTap"
          >
            <!-- 关卡编号 -->
            <view class="level-number" style="background: {{level.isUnlocked ? level.lineColor : '#6b7280'}}">
              <text class="level-num-text">{{level.id <= 8 ? level.id : level.id - 100}}</text>
            </view>

            <!-- 关卡名称 -->
            <text class="level-name">{{level.name}}</text>

            <!-- 星级评价 -->
            <view class="level-stars" tt:if="{{level.isCompleted}}">
              <text class="star {{level.stars >= 1 ? 'star-filled' : ''}}">*</text>
              <text class="star {{level.stars >= 2 ? 'star-filled' : ''}}">*</text>
              <text class="star {{level.stars >= 3 ? 'star-filled' : ''}}">*</text>
            </view>

            <!-- 最高分 -->
            <text class="level-score" tt:if="{{level.isCompleted}}">{{level.bestScore}}分</text>

            <!-- 锁定提示 -->
            <view class="lock-overlay" tt:if="{{!level.isUnlocked}}">
              <text class="lock-text">X</text>
            </view>

            <!-- 已通关标记 -->
            <view class="completed-badge" tt:if="{{level.isCompleted}}">
              <text class="completed-text">OK</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部导航 -->
  <view class="footer">
    <view class="nav-btn" bindtap="goToProfile">
      <text class="nav-btn-icon">U</text>
      <text class="nav-btn-text">我的</text>
    </view>
    <view class="nav-btn" bindtap="goToRank">
      <text class="nav-btn-icon">R</text>
      <text class="nav-btn-text">排行</text>
    </view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-mask" tt:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载关卡...</text>
    </view>
  </view>
</view>