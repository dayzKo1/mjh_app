/* 关卡选择页面样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #2d5a27 0%, #3d7a35 20%, #4a8f42 50%, #3d7a35 80%, #2d5a27 100%);
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  box-sizing: border-box;
}

/* ===== 顶部状态栏 ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(0, 0, 0, 0.18);
  border-radius: 40rpx;
  margin-bottom: 24rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: 900;
  color: #f7e358;
  text-shadow: 0 2rpx 0 #8b6914, 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
  letter-spacing: 4rpx;
}

.header-right {
  display: flex;
  align-items: center;
}

.score-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.score-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #f7e358;
}

/* ===== 关卡网格 ===== */
.levels-container {
  flex: 1;
  overflow-y: auto;
}

.levels-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 8rpx;
}

.level-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
  position: relative;
}

.level-item.unlocked {
  background: linear-gradient(170deg, #fffef9 0%, #faf5e8 40%, #efe0c6 100%);
  border-color: rgba(200, 160, 80, 0.35);
}

.level-item.unlocked:active {
  transform: scale(0.96);
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.25);
}

.level-item.locked {
  opacity: 0.6;
}

/* ===== 关卡编号 ===== */
.level-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.level-num-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #5a3e0b;
}

/* ===== 关卡信息 ===== */
.level-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.level-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #5a3e0b;
}

.level-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 24rpx;
  color: rgba(200, 160, 80, 0.3);
}

.star-filled {
  color: #f7e358;
}

.level-score {
  font-size: 22rpx;
  color: #8b6914;
}

.level-locked-info {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.level-item.locked .level-name,
.level-item.locked .level-locked-info {
  color: rgba(255, 255, 255, 0.6);
}

/* ===== 锁定图标 ===== */
.lock-icon {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.lock-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ===== 已通关标记 ===== */
.completed-mark {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(180deg, #4CAF50, #388E3C);
  border-radius: 12rpx;
}

.completed-text {
  font-size: 18rpx;
  font-weight: bold;
  color: #fff;
}

/* ===== 底部导航 ===== */
.footer {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx;
  margin-top: 24rpx;
}

.nav-btn {
  padding: 16rpx 40rpx;
  background: linear-gradient(180deg, #f7e358, #e8c830);
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(247, 227, 88, 0.4);
}

.nav-btn:active {
  transform: scale(0.95);
}

.nav-btn-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #5a3e0b;
}

/* ===== 加载提示 ===== */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.loading-text {
  font-size: 32rpx;
  color: #f7e358;
}