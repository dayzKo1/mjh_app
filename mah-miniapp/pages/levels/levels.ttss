/* 关卡选择页面样式 - 麻将消消乐主题 */

.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a3f 40%, #3d6b4f 70%, #1a472a 100%);
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  position: relative;
}

/* ===== 顶部状态栏 ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logo-mini {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(145deg, #2d5a3f, #1a472a);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.logo-icon-text {
  font-size: 24rpx;
  font-weight: 900;
  color: #fff;
}

.title {
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.5);
}

.header-right {
  display: flex;
  align-items: center;
}

.score-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(145deg, #fff, #f0f5f0);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.score-label {
  font-size: 16rpx;
  color: #1a472a;
}

.score-value {
  font-size: 20rpx;
  font-weight: 700;
  color: #0d2818;
}

/* ===== 分支选择 ===== */
.branch-tabs {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 0;
  margin-top: 12rpx;
}

.branch-tab {
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.branch-tab.active {
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transform: translateY(-2rpx);
}

.branch-tab-text {
  font-size: 28rpx;
  font-weight: 700;
}

/* ===== 关卡滚动区域 ===== */
.levels-container {
  flex: 1;
  padding: 12rpx 0;
  overflow: hidden;
}

.lines-wrapper {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 8rpx 16rpx;
}

/* ===== 线路区块 ===== */
.line-section {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}

.line-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.3);
}

.line-indicator {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.line-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

/* ===== 关卡行 ===== */
.levels-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.level-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 16rpx;
  min-width: 90rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
  position: relative;
}

.level-card.unlocked {
  background: linear-gradient(170deg, #fffef9 0%, #faf5e8 40%, #fff 100%);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.level-card.unlocked:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.level-card.locked {
  opacity: 0.5;
  background: rgba(156, 163, 175, 0.3);
}

/* ===== 关卡编号 ===== */
.level-number {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.level-num-text {
  font-size: 22rpx;
  font-weight: 900;
  color: #fff;
}

/* ===== 关卡名称 ===== */
.level-name {
  font-size: 18rpx;
  font-weight: 700;
  color: #1a472a;
  text-align: center;
}

.level-card.locked .level-name {
  color: #6b7280;
}

/* ===== 星级评价 ===== */
.level-stars {
  display: flex;
  gap: 2rpx;
  margin-top: 4rpx;
}

.star {
  font-size: 16rpx;
  color: rgba(156, 163, 175, 0.4);
}

.star-filled {
  color: #22c55e;
}

/* ===== 最高分 ===== */
.level-score {
  font-size: 14rpx;
  color: #0d2818;
  font-weight: 600;
  margin-top: 2rpx;
}

/* ===== 锁定覆盖层 ===== */
.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
}

.lock-text {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 已通关标记 ===== */
.completed-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  padding: 4rpx 8rpx;
  background: #22c55e;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.completed-text {
  font-size: 12rpx;
  font-weight: 700;
  color: #fff;
}

/* ===== 底部导航 ===== */
.footer {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 16rpx 0;
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
}

.nav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.nav-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.8);
}

.nav-btn-icon {
  font-size: 28rpx;
  font-weight: 900;
  color: #1a472a;
}

.nav-btn-text {
  font-size: 16rpx;
  font-weight: 600;
  color: #2d5a3f;
}

/* ===== 加载提示 ===== */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 71, 42, 0.9);
  z-index: 100;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 48rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: conic-gradient(#22c55e 0deg 270deg, transparent 270deg 360deg);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #1a472a;
}