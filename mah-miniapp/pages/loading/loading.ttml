<!-- 开屏加载页面 - 包了个包主题 -->
<view class="loading-container">
  <!-- 游戏Logo -->
  <view class="logo-container">
    <view class="logo-icon">
      <text class="logo-emoji">B</text>
    </view>
    <text class="logo-title">包了个包</text>
    <text class="logo-subtitle">麻将三消益智游戏</text>
  </view>

  <!-- 加载进度区域 -->
  <view class="progress-area">
    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{loadingProgress}}%"></view>
      <view class="progress-glow"></view>
    </view>
    <view class="progress-info">
      <text class="progress-text">{{loadingProgress}}%</text>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>

  <!-- 游戏提示 - 面包主题 -->
  <view class="tips-area" tt:if="{{showTip}}">
    <view class="tip-icon">
      <text class="tip-emoji">* </text>
    </view>
    <text class="tip-content">{{tips[tipIndex]}}</text>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">v1.0.0</text>
  </view>
</view>