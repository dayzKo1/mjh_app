/* 开屏加载页面 - 包了个包主题 */

.loading-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  background: linear-gradient(180deg, #fef3c7 0%, #fde68a 30%, #fcd34d 60%, #f59e0b 100%);
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.loading-container::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.3) 0%, transparent 50%),
              radial-gradient(circle at 70% 80%, rgba(251, 191, 36, 0.2) 0%, transparent 40%);
  animation: bgFloat 8s ease-in-out infinite;
}

@keyframes bgFloat {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  50% { transform: translate(-5%, 5%) rotate(2deg); }
}

/* Logo区域 */
.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 10;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #fff8dc, #ffe4b5);
  box-shadow: 
    0 8rpx 32rpx rgba(245, 158, 11, 0.3),
    0 4rpx 16rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  animation: logoFloat 3s ease-in-out infinite;
}

@keyframes logoFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-8rpx) rotate(2deg); }
}

.logo-emoji {
  font-size: 60rpx;
  color: #fff;
  font-weight: 900;
}

.logo-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #92400e;
  text-shadow: 
    0 2rpx 0 #fef3c7,
    0 4rpx 8rpx rgba(120, 53, 15, 0.3);
  letter-spacing: 6rpx;
}

.logo-subtitle {
  font-size: 20rpx;
  color: #b45309;
  font-weight: 500;
}

/* 进度区域 */
.progress-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 10;
  width: 400rpx;
}

.progress-bar-bg {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 
    0 2rpx 8rpx rgba(245, 158, 11, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #d97706, #b45309);
  border-radius: 8rpx;
  transition: width 0.3s ease;
  position: relative;
}

.progress-glow {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6));
  animation: glowPulse 1s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.progress-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #92400e;
}

.loading-text {
  font-size: 18rpx;
  color: #a16207;
}

/* 提示区域 - 面包主题 */
.tips-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.15);
  z-index: 10;
  animation: tipSlide 0.5s ease-out;
}

@keyframes tipSlide {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-emoji {
  font-size: 24rpx;
  color: #f59e0b;
}

.tip-content {
  font-size: 18rpx;
  color: #78350f;
  font-weight: 500;
}

/* 版本信息 */
.version-info {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  z-index: 10;
}

.version-text {
  font-size: 14rpx;
  color: rgba(120, 53, 15, 0.5);
}