.container {
  background: linear-gradient(180deg, #6b8e6b 0%, #8dac85 30%, #6b8e6b 100%);
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

.user-card {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.avatar-wrap {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ccc;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-default {
  background: #bbb;
}

.user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.edit-btn {
  font-size: 28rpx;
  opacity: 0.7;
}

.user-type-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  align-self: flex-start;
}

.type-a {
  background: rgba(92, 184, 92, 0.85);
  color: #fff;
}

.type-b {
  background: rgba(160, 160, 160, 0.6);
  color: #ddd;
}

.asset-card {
  width: 100%;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.asset-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-main {
  flex: 1.2;
}

.asset-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.asset-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}

.asset-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.asset-value-sm {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}

.asset-unit-sm {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
}

.asset-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.withdraw-btn {
  width: 100%;
  padding: 18rpx 0;
  text-align: center;
  background: linear-gradient(180deg, #5cb85c 0%, #449d44 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  letter-spacing: 2rpx;
  transition: all 0.15s ease;
}

.withdraw-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.stats-card {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.feature-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.feature-item {
  width: calc(50% - 10rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.15s ease;
}

.feature-item:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.18);
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
  border-radius: 50%;
}

.icon-rank {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
}

.icon-invite {
  background: linear-gradient(135deg, #5cb85c, #449d44);
}

.icon-record {
  background: linear-gradient(135deg, #5bc0de, #31b0d5);
}

.icon-about {
  background: linear-gradient(135deg, #a0a0a0, #808080);
}

.feature-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
}
