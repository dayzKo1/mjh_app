<!-- 个人中心页面 -->
<view class="container">

  <!-- 顶部用户信息卡片 -->
  <view class="user-card">
    <view class="avatar-wrap">
      <image
        tt:if="{{userInfo.avatarUrl}}"
        class="avatar"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      />
      <view tt:else class="avatar avatar-default"></view>
    </view>
    <view class="user-info">
      <view class="nickname-row">
        <text class="nickname">{{userInfo.nickName || '未登录'}}</text>
        <image class="edit-icon" src="/images/icons/edit_icon.png" mode="aspectFit" bindtap="onEditNickname" />
      </view>
      <view class="user-type-tag {{userType === 'A' ? 'type-a' : 'type-b'}}">
        {{userType === 'A' ? 'A类用户' : 'B类用户'}}
      </view>
    </view>
  </view>

  <!-- 游戏数据卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{maxLevel}}</text>
      <text class="stat-label">最高关卡</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{totalScore}}</text>
      <text class="stat-label">累计得分</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{totalGames}}</text>
      <text class="stat-label">游戏次数</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="feature-grid">
    <view class="feature-item" bindtap="onRank">
      <image class="feature-icon-img" src="/images/icons/feature_rank.png" mode="aspectFit" />
      <text class="feature-text">排行榜</text>
    </view>
    <view class="feature-item" bindtap="onInvite">
      <image class="feature-icon-img" src="/images/icons/feature_invite.png" mode="aspectFit" />
      <text class="feature-text">邀请好友</text>
    </view>
    <view class="feature-item" bindtap="onGameRecords">
      <image class="feature-icon-img" src="/images/icons/feature_record.png" mode="aspectFit" />
      <text class="feature-text">游戏记录</text>
    </view>
    <view class="feature-item" bindtap="onAbout">
      <image class="feature-icon-img" src="/images/icons/feature_about.png" mode="aspectFit" />
      <text class="feature-text">关于</text>
    </view>
    <view class="feature-item" bindtap="onContactService">
      <image class="feature-icon-img" src="/images/icons/feature_service.png" mode="aspectFit" />
      <text class="feature-text">客服</text>
    </view>
  </view>

</view>
